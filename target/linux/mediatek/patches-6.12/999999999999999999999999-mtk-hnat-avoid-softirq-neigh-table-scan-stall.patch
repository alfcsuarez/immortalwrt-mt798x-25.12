 			     void *ptr)
 {
-	struct net_device *dev = NULL;
-	struct neighbour *neigh = NULL;
+	struct net_device *dev;
+	struct neighbour *neigh;
+	struct hnat_neigh_event *ev, *new_ev = NULL;
+	__be32 dip;
+	u8 ha[ETH_ALEN];
+	u8 nud_state;
 
-	switch (event) {
-	case NETEVENT_NEIGH_UPDATE:
-		neigh = ptr;
-		dev = neigh->dev;
-		if (dev)
-			foe_clear_entry(neigh);
-		break;
+	if (event != NETEVENT_NEIGH_UPDATE || !ptr)
+		return NOTIFY_DONE;
+
+	neigh = ptr;
+	dev = neigh->dev;
+	if (!dev || dev->addr_len != ETH_ALEN || !neigh->tbl ||
+	    neigh->tbl->family != AF_INET || !net_eq(dev_net(dev), &init_net))
+		return NOTIFY_DONE;
+
+	nud_state = READ_ONCE(neigh->nud_state);
+	if (!(nud_state & (NUD_CONNECTED | NUD_FAILED)))
+		return NOTIFY_DONE;
+
+	memcpy(&dip, neigh->primary_key, sizeof(dip));
+	neigh_ha_snapshot((char *)ha, neigh, dev);
+	nud_state = READ_ONCE(neigh->nud_state);
+	if (!(nud_state & (NUD_CONNECTED | NUD_FAILED)))
+		return NOTIFY_DONE;
+	if ((nud_state & NUD_CONNECTED) && !is_valid_ether_addr(ha))
+		return NOTIFY_DONE;
+
+	spin_lock_bh(&hnat_neigh_lock);
+	if (hnat_neigh_stopping || !hnat_neigh_wq)
+		goto out_unlock;
+
+	list_for_each_entry(ev, &hnat_neigh_list, list) {
+		if (ev->dip == dip) {
+			ev->nud_state = nud_state;
+			memcpy(ev->ha, ha, ETH_ALEN);
+			goto schedule_work;
+		}
+	}
+
+	if (hnat_neigh_pending >= HNAT_NEIGH_MAX_PENDING) {
+		hnat_neigh_overflow = true;
+		goto schedule_work;
+	}
+
+	spin_unlock_bh(&hnat_neigh_lock);
+	new_ev = kmalloc(sizeof(*new_ev), GFP_ATOMIC);
+	spin_lock_bh(&hnat_neigh_lock);
+
+	if (hnat_neigh_stopping || !hnat_neigh_wq) {
+		kfree(new_ev);
+		goto out_unlock;
+	}
+
+	list_for_each_entry(ev, &hnat_neigh_list, list) {
+		if (ev->dip == dip) {
+			ev->nud_state = nud_state;
+			memcpy(ev->ha, ha, ETH_ALEN);
+			kfree(new_ev);
+			goto schedule_work;
+		}
+	}
+
+	if (!new_ev || hnat_neigh_pending >= HNAT_NEIGH_MAX_PENDING) {
+		kfree(new_ev);
+		hnat_neigh_overflow = true;
+	} else {
+		new_ev->dip = dip;
+		new_ev->nud_state = nud_state;
+		memcpy(new_ev->ha, ha, ETH_ALEN);
+		list_add_tail(&new_ev->list, &hnat_neigh_list);
+		hnat_neigh_pending++;
 	}
 
+schedule_work:
+	if (!delayed_work_pending(&hnat_neigh_work))
+		queue_delayed_work(hnat_neigh_wq, &hnat_neigh_work,
+				   msecs_to_jiffies(HNAT_NEIGH_BATCH_DELAY_MS));
+out_unlock:
+	spin_unlock_bh(&hnat_neigh_lock);
 	return NOTIFY_DONE;
 }
 
