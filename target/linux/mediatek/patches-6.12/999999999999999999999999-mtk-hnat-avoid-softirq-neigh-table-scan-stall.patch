+static void hnat_neigh_work_handler(struct work_struct *work)
+{
+	struct hnat_neigh_event *ev, *tmp;
+	LIST_HEAD(local_list);
+	bool overflow, stopping;
+
+	spin_lock_bh(&hnat_neigh_lock);
+	stopping = hnat_neigh_stopping;
+	overflow = hnat_neigh_overflow;
+	hnat_neigh_overflow = false;
+	list_splice_init(&hnat_neigh_list, &local_list);
+	hnat_neigh_pending = 0;
+	spin_unlock_bh(&hnat_neigh_lock);
+
+	if (!stopping) {
+		if (overflow) {
+			foe_clear_all_bind_entries();
+		} else if (!list_empty(&local_list) &&
+			   hnat_external_callback_enter()) {
+			foe_clear_entry_batch(&local_list);
+			hnat_external_callback_exit();
+		}
+	}
+
+	list_for_each_entry_safe(ev, tmp, &local_list, list) {
+		list_del(&ev->list);
+		kfree(ev);
+	}
+
+	spin_lock_bh(&hnat_neigh_lock);
+	if (!hnat_neigh_stopping && hnat_neigh_wq &&
+	    (!list_empty(&hnat_neigh_list) || hnat_neigh_overflow) &&
+	    !delayed_work_pending(&hnat_neigh_work))
+		queue_delayed_work(hnat_neigh_wq, &hnat_neigh_work,
+				   msecs_to_jiffies(HNAT_NEIGH_BATCH_DELAY_MS));
+	spin_unlock_bh(&hnat_neigh_lock);
+}
+
+int hnat_neigh_update_init(void)
+{
+	struct workqueue_struct *wq;
+
+	spin_lock_bh(&hnat_neigh_lock);
+	if (hnat_neigh_wq) {
+		hnat_neigh_stopping = false;
+		spin_unlock_bh(&hnat_neigh_lock);
+		return 0;
+	}
+	spin_unlock_bh(&hnat_neigh_lock);
+
+	wq = alloc_ordered_workqueue("hnat_neigh", 0);
+	if (!wq)
+		return -ENOMEM;
+
+	spin_lock_bh(&hnat_neigh_lock);
+	if (hnat_neigh_wq) {
+		hnat_neigh_stopping = false;
+		spin_unlock_bh(&hnat_neigh_lock);
+		destroy_workqueue(wq);
+		return 0;
+	}
+	hnat_neigh_wq = wq;
+	hnat_neigh_overflow = false;
+	hnat_neigh_stopping = false;
+	spin_unlock_bh(&hnat_neigh_lock);
+
+	return 0;
+}
+
+void hnat_neigh_update_cleanup(void)
+{
+	struct workqueue_struct *wq;
+	struct hnat_neigh_event *ev, *tmp;
+	LIST_HEAD(local_list);
+
+	spin_lock_bh(&hnat_neigh_lock);
+	hnat_neigh_stopping = true;
+	wq = hnat_neigh_wq;
+	hnat_neigh_wq = NULL;
+	list_splice_init(&hnat_neigh_list, &local_list);
+	hnat_neigh_pending = 0;
+	hnat_neigh_overflow = false;
+	spin_unlock_bh(&hnat_neigh_lock);
+
+	list_for_each_entry_safe(ev, tmp, &local_list, list) {
+		list_del(&ev->list);
+		kfree(ev);
+	}
+
+	if (!wq)
+		return;
+
+	cancel_delayed_work_sync(&hnat_neigh_work);
+	destroy_workqueue(wq);
+
+	spin_lock_bh(&hnat_neigh_lock);
+	list_splice_init(&hnat_neigh_list, &local_list);
+	hnat_neigh_pending = 0;
+	hnat_neigh_overflow = false;
+	spin_unlock_bh(&hnat_neigh_lock);
+
+	list_for_each_entry_safe(ev, tmp, &local_list, list) {
+		list_del(&ev->list);
+		kfree(ev);
+	}
 }
 
