+static inline bool hnat_entry_peek_bind(const struct foe_entry *entry,
+					u32 *pkt_type)
+{
+	union {
+		struct hnat_bind_info_blk bind;
+		u32 raw;
+	} ib1;
+
+	/* Lockless single-word IB1 read to skip unbound slots before spinlocks. */
+	ib1.raw = READ_ONCE(*(const u32 *)entry);
+	if (ib1.bind.state != BIND)
+		return false;
+	if (pkt_type)
+		*pkt_type = ib1.bind.pkt_type;
+	return true;
+}
+
