+
+struct hnat_neigh_event {
+	struct list_head list;
+	__be32 dip;
+	u8 ha[ETH_ALEN];
+	u8 nud_state;
+};
+
+static DEFINE_SPINLOCK(hnat_neigh_lock);
+static LIST_HEAD(hnat_neigh_list);
